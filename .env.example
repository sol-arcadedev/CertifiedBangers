# Copy this file to .env (or .env.local) and fill in real values.
# Never commit the filled-in file — .env and .env*.local are gitignored.

# Postgres connection string from your Supabase project
# (Project Settings -> Database -> Connection string -> URI, "Transaction" mode
# pooler recommended for serverless/Vercel deployments).
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase project API settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-PUBLIC-KEY]"

# Server-only — never expose to the client. Used for admin-level operations
# (e.g. Vercel Cron probation-streak job, Journal Entry 36).
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"
