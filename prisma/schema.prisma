// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
  MAIN_ADMIN
}

// WP6.1 moderation: an account's platform-wide standing, independent of
// role. Checked once in requireUser() so every write action (review,
// comment, vote, report, library) is blocked in one place rather than
// re-implemented per action. Existing content isn't retroactively hidden
// when a user is suspended/banned — only future actions are blocked.
enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum TitleType {
  MANGA
  MANHWA
  MANHUA
}

enum TitleStatus {
  ONGOING
  COMPLETED
  HIATUS
  DROPPED
}

// Entry 28: admin-authored reviews from anyone but the Main Admin sit in
// PENDING_APPROVAL until the Main Admin approves them. Entry 42: a pending
// review must not be readable/votable/commentable/seal-eligible.
enum ReviewApprovalStatus {
  PUBLISHED
  PENDING_APPROVAL
  REJECTED
}

// Entry 18/19: four statuses, independent of whether a review exists.
enum LibraryStatus {
  FINISHED
  CURRENTLY_READING
  PLAN_TO_READ
  DROPPED
}

// Entry 9/11/12/13: provisional -> permanent probation state machine.
enum SealAwardStatus {
  PROVISIONAL
  PERMANENT
}

enum SealGrantedVia {
  ADMIN
  VOTE_THRESHOLD
}

enum VoteTargetType {
  REVIEW
  COMMENT
}

enum VoteValue {
  UP
  DOWN
}

enum ReportTargetType {
  REVIEW
  COMMENT
  TITLE
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

// Singleton row (fixed id) for platform-wide config the Main Admin can tune
// without a code deploy — starts with just the review-submission gate
// (Entry 40: email verification is mandatory/not configurable, but the
// minimum account age is meant to be admin-adjustable), but is the natural
// home for future knobs of the same kind (e.g. the seal probation streak
// length hardcoded today, Entry 12) rather than a new singleton table each time.
model PlatformSettings {
  id                       String   @id @default("singleton")
  minAccountAgeDays        Int      @default(3)
  // Net vote score (upvotes - downvotes) a review must reach to become an
  // automatic Phase 2 Certified Banger candidate (Entry 8/29 — starting
  // value +20).
  sealQualityGateThreshold Int      @default(20)
  // WP6.2 spam mitigation — each is a per-user cap over a fixed 1-hour
  // window (the window itself isn't configurable, same as the review
  // gate's account-age-only tunability). Reviews count new submissions
  // only, not edits of an existing one (edit-replace doesn't grow content
  // volume); votes count new Vote rows only, not toggle-off/switch (an
  // "undo" shouldn't burn the same budget as a new vote).
  reviewRateLimitPerHour   Int      @default(10)
  commentRateLimitPerHour  Int      @default(20)
  voteRateLimitPerHour     Int      @default(60)
  reportRateLimitPerHour   Int      @default(10)
  updatedAt                DateTime @updatedAt

  @@map("platform_settings")
}

// App-profile row for a Supabase Auth user. `id` is NOT auto-generated here —
// it is set to the same UUID as the corresponding auth.users.id (Entry 34:
// Supabase Auth owns credentials/sessions; this table only owns profile data).
model User {
  id                          String     @id
  username                    String     @unique
  email                       String     @unique
  avatarUrl                   String?
  bannerUrl                   String?
  bio                         String?
  role                        Role       @default(USER)
  status                      UserStatus @default(ACTIVE)
  // Entry 28/41: only meaningful when role = ADMIN; the Main Admin lifts this
  // per-admin, by manual judgment, not an automatic rule.
  adminReviewsRequireApproval Boolean    @default(true)
  reputationScore             Int        @default(0)
  createdAt                   DateTime   @default(now())

  reviews           Review[]
  libraryEntries    LibraryEntry[]
  comments          Comment[]
  votes             Vote[]
  reports           Report[]       @relation("ReporterReports")
  sealAwardsAsAdmin SealAward[]    @relation("SealGrantedByAdmin")
  following         Follow[]       @relation("Following")
  followers         Follow[]       @relation("Followers")

  @@map("users")
}

// Entry 54: who follows whom. The activity feed itself has no dedicated
// event-log table — a followed user's qualifying activity (review
// created, library status set to Finished/Dropped) is derived live from
// Review/LibraryEntry at feed-render time, the same "derive from source
// data" pattern used for Reader Activity and the profile Library stat.
model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id])
  following User @relation("Followers", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model Title {
  id                  String      @id @default(uuid())
  // Null for a manually-created title (Entry 44's fallback path); set for
  // one imported from AniList, and used to prevent re-importing the same
  // title twice.
  anilistId           Int?        @unique
  // Reference metadata from AniList, not this platform's own rating —
  // deliberately separate from overallScore, which stays a pure average of
  // this platform's own reviews (brief's "not a single opaque score"
  // pitch). Only set for imported titles; refreshed periodically via
  // scripts/refresh-anilist-data.ts since AniList's numbers drift over time.
  anilistAverageScore Int? // 0-100
  anilistMeanScore    Int? // 0-100
  anilistPopularity   Int?
  anilistFavourites   Int?
  anilistSource       String? // AniList's source enum, e.g. "WEB_NOVEL"
  name                String
  // Distinct per-language titles + synonyms, same shape AniList itself
  // uses. synonyms is admin-editable via the manual form (repurposed from
  // the old single altNames[] field); the per-language titles are not.
  titleRomaji         String?
  titleEnglish        String?
  titleNative         String?
  synonyms            String[]
  type                TitleType
  status              TitleStatus
  author              String?
  illustrator         String?
  genres              String[]
  coverUrl            String?
  synopsis            String?
  publicationYear     Int?
  startMonth          Int?
  startDay            Int?
  externalLinks       String[]
  createdAt           DateTime    @default(now())
  // Entry 58: trigger-maintained (not GENERATED ALWAYS AS — to_tsvector()
  // isn't IMMUTABLE) full-text search column, GIN-indexed. Prisma can't
  // express or manage this column's type/trigger, so it's declared
  // Unsupported here purely for documentation — created and kept in sync
  // entirely via scripts/add-search-index.ts.
  //
  // IMPORTANT, confirmed by hitting it directly: `prisma db push` DOES
  // drop this column's GIN index (and would drop the four DESC NULLS
  // LAST sort indexes below too — see the comment above those) even
  // though it can't touch the Unsupported column itself, because db push
  // reconciles the DB to exactly match what's declared here, and an
  // index with no corresponding @@index is invisible to that
  // reconciliation only for the column type, not the index object. Any
  // `prisma db push` MUST be followed immediately by re-running
  // scripts/add-search-index.ts and scripts/add-sort-indexes.ts, or
  // search/sort silently falls back to full sequential scans again.
  searchVector        Unsupported("tsvector")?

  // Precomputed aggregates (Entry 39) — updated incrementally on
  // review/vote/seal/comment events, never recalculated live on read.
  avgCategoryScores    Json? // { [categoryId]: avgScore }
  reviewCount          Int       @default(0)
  certifiedBangerCount Int       @default(0)
  // WP5.1 browse/sort fields, same precompute pattern as the above.
  communityScore       Float? // mean of avgCategoryScores' values — "highest overall score" sort
  lastReviewedAt       DateTime? // max createdAt of PUBLISHED reviews — "most recent reviews" sort
  discussionCount      Int       @default(0) // total comments across the title's reviews — "most discussed" sort

  reviews        Review[]
  libraryEntries LibraryEntry[]

  @@index([type, status])
  @@index([name])
  // Entry 58: one index per /titles sort option — at 100k+ mirrored
  // titles, sorting/filtering on any of these without an index forced a
  // full seq scan of every full-width row (synopsis text, genre/synonym
  // arrays included) just to find the top 24. certifiedBangerCount and
  // discussionCount are never null, so a plain index matches their
  // (desc) query exactly. anilistAverageScore/anilistPopularity/
  // communityScore/lastReviewedAt are all sorted `desc, nulls: last` —
  // Prisma's @@index can't express NULLS ordering, and a plain ascending
  // index doesn't satisfy that query shape (Postgres falls back to a
  // full scan regardless of how many rows are actually null), so those
  // four get DESC NULLS LAST indexes via raw SQL instead, same pattern
  // as searchVector's trigger/index — see scripts/add-sort-indexes.ts.
  @@index([certifiedBangerCount])
  @@index([discussionCount])
  @@map("titles")
}

// Data-driven, not hardcoded (Entry 2) — five seed rows for v1
// (Art Style, Character, Plot, Pacing, Uniqueness).
model Category {
  id            String      @id @default(uuid())
  name          String      @unique
  appliesToType TitleType[]
  scaleMin      Int         @default(1)
  scaleMax      Int         @default(10)

  scores ReviewCategoryScore[]

  @@map("categories")
}

model Review {
  id                   String               @id @default(uuid())
  userId               String
  titleId              String
  // Computed as the simple average of this review's category scores (Entry 4).
  overallScore         Float?
  bodyText             String
  // The main review body must stay spoiler-free by policy (enforced by
  // moderation via the report system, not automatically) — spoiler-specific
  // thoughts go here instead, always rendered collapsed by default on the
  // strength of simply having content, no separate boolean flag needed.
  spoilerText          String?
  isAdminAuthored      Boolean              @default(false)
  approvalStatus       ReviewApprovalStatus @default(PUBLISHED)
  // Derived flag used by the future first-review reward (Entry 22/26).
  isFirstReviewOfTitle Boolean              @default(false)
  // Precomputed from the Vote table (WP3.1), same incremental-aggregate
  // pattern as Title's scores (Entry 39) — never recalculated live on
  // read. Net score for display is upvoteCount - downvoteCount, not a
  // separately stored field.
  upvoteCount          Int                  @default(0)
  downvoteCount        Int                  @default(0)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  user           User                  @relation(fields: [userId], references: [id])
  title          Title                 @relation(fields: [titleId], references: [id])
  categoryScores ReviewCategoryScore[]
  comments       Comment[]
  sealAwards     SealAward[]

  // One review per user per title — editing replaces, never duplicates.
  @@unique([userId, titleId])
  @@index([titleId])
  @@index([approvalStatus])
  @@map("reviews")
}

model ReviewCategoryScore {
  id         String @id @default(uuid())
  reviewId   String
  categoryId String
  score      Int

  review   Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([reviewId, categoryId])
  @@map("review_category_scores")
}

// Data-driven (Entry 14) — v1 seed row: "Certified Banger". Hidden Gem
// shipped at launch and was removed (Entry 45); the table stays data-driven
// so a future seal type is a data change, not a deploy.
model SealType {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  icon        String?

  awards SealAward[]

  @@map("seal_types")
}

// Attaches to a review, not the title directly (Entry 7); title-level counts
// are precomputed aggregates on Title, updated when a SealAward's status changes.
model SealAward {
  id                  String          @id @default(uuid())
  reviewId            String
  sealTypeId          String
  // Required, separate from the review body (Entry 5).
  justificationText   String
  status              SealAwardStatus @default(PROVISIONAL)
  grantedVia          SealGrantedVia
  grantedByAdminId    String?
  grantedAt           DateTime        @default(now())
  // Entry 12: increments daily while net vote score stays >= 0; resets to 0
  // on any negative dip; converts to PERMANENT at 30. Entry 11: only tracked
  // for grantedVia = VOTE_THRESHOLD — ADMIN grants are permanent immediately.
  positiveStreakDays  Int             @default(0)
  lastStreakResetAt   DateTime?
  permanentAt         DateTime?
  // Entry 13: manual admin override note when a permanent seal is demoted/removed.
  adminOverrideStatus String?

  review         Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  sealType       SealType @relation(fields: [sealTypeId], references: [id])
  grantedByAdmin User?    @relation("SealGrantedByAdmin", fields: [grantedByAdminId], references: [id])

  // A review can hold multiple distinct seal types at once (Entry 15), but
  // only one award per seal type per review.
  @@unique([reviewId, sealTypeId])
  @@map("seal_awards")
}

// New v1 entity (Entry 18/19) — independent of Review.
model LibraryEntry {
  id        String        @id @default(uuid())
  userId    String
  titleId   String
  status    LibraryStatus
  addedAt   DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  title Title @relation(fields: [titleId], references: [id])

  @@unique([userId, titleId])
  @@map("library_entries")
}

model Comment {
  id        String   @id @default(uuid())
  userId    String
  reviewId  String
  bodyText  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  votes  Vote[]

  @@map("comments")
}

// Polymorphic target (review | comment) — no DB-level FK to either, enforced
// in application code, matching the brief's original Vote design.
model Vote {
  id         String         @id @default(uuid())
  userId     String
  targetType VoteTargetType
  targetId   String
  value      VoteValue
  createdAt  DateTime       @default(now())

  user      User     @relation(fields: [userId], references: [id])
  comment   Comment? @relation(fields: [commentId], references: [id])
  commentId String?

  // Section 4.5 / Security 4.5: one vote per user per target, enforced at the DB level.
  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("votes")
}

model Report {
  id             String           @id @default(uuid())
  reporterUserId String
  targetType     ReportTargetType
  targetId       String
  reason         String
  status         ReportStatus     @default(OPEN)
  createdAt      DateTime         @default(now())

  reporter User @relation("ReporterReports", fields: [reporterUserId], references: [id])

  @@index([status])
  @@map("reports")
}
